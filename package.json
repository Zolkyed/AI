{
  "name": "ai",
  "version": "1.3.2",
  "private": true,
  "description": "Reusable TypeScript repository template for AI-assisted development.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "fix": "pnpm run format && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && git diff --check",
    "build": "tsc -p tsconfig.build.json",
    "verify": "pnpm run check && pnpm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
