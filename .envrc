# Load worktree-local environment values.
dotenv_if_exists .env
dotenv_if_exists .env.local

# Activate runtimes pinned by mise when it is installed.
if has mise; then
  eval "$(mise direnv)"
  use mise
fi

# Synchronize and activate the worktree-local Python environment.
if [[ -f pyproject.toml ]] && has uv; then
  uv sync --quiet || true
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi

# Expose worktree-local Node dependencies for pnpm projects.
if [[ -f package.json ]] && has pnpm; then
  PATH_add "$PWD/node_modules/.bin"
fi
