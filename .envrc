# Load worktree-local environment values.
dotenv_if_exists .env
dotenv_if_exists .env.local

# Expose an existing worktree-local Python environment.
if [[ -d .venv ]]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi

# Expose existing worktree-local Node dependencies.
if [[ -d node_modules/.bin ]]; then
  PATH_add "$PWD/node_modules/.bin"
fi
