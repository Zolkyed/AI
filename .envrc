main_worktree="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"

# Load shared values first, then allow the active worktree to override them.
dotenv_if_exists "$main_worktree/.env"
if [[ "$PWD" != "$main_worktree" ]]; then
  dotenv_if_exists .env
fi

# Reuse the main worktree's Python environment when one exists.
if [[ -d "$main_worktree/.venv" ]]; then
  export VIRTUAL_ENV="$main_worktree/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi

# Keep Node dependencies isolated to the active worktree.
if [[ -d "$PWD/node_modules/.bin" ]]; then
  PATH_add "$PWD/node_modules/.bin"
fi

# Activate runtimes pinned by mise when it is installed.
if has mise; then
  eval "$(mise direnv)"
  use mise
fi
