#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <worktree-name>" >&2
  echo "Example: cd \"\$(./scripts/worktree-create issue26)\"" >&2
  exit 2
fi

worktree_name="$1"

[[ "$worktree_name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
  { echo "Worktree name must use lowercase kebab-case" >&2; exit 2; }

repo_root="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
worktree_root="${WORKTREE_ROOT:-$repo_root/.worktrees}"
worktree="$worktree_root/$worktree_name"

git fetch origin main >&2
mkdir -p "$worktree_root"
git worktree add --detach "$worktree" origin/main >&2

printf "%s\n" "$worktree"
